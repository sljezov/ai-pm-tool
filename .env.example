# Relative file paths are resolved from the repository root.
DATABASE_URL="file:./prisma/dev.db"
# Manual functionality works without AI. Use fixture for repeatable demonstrations.
AI_PROVIDER="fixture"
# For live AI set AI_PROVIDER="openai" and provide both server-only values.
OPENAI_API_KEY=""
OPENAI_MODEL=""
# Or set AI_PROVIDER="anthropic" and provide both server-only values instead.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
